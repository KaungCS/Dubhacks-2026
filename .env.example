# App
CLUB_NAME="Your Club Name"
CLUB_TIMEZONE="America/Los_Angeles"

# Auth.js / NextAuth
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth Web client (see docs/google-oauth-setup.md in the Project store,
# or the setup section in README)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: public origin for Auth.js (set in production, e.g. https://your-app.vercel.app)
# AUTH_URL=http://localhost:3000

# Optional LLM for richer plans. If unset, a deterministic stub plan is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
