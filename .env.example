# Copy to .env.local for local/dev (do not commit .env.local).
# Teammates: use this file — do NOT rely on Cursor Cloud Environment secrets
# (Cloud "Save secrets" may show "Repository is not ready yet").

# App
CLUB_NAME="Your Club Name"
CLUB_TIMEZONE="America/Los_Angeles"

# Auth.js / NextAuth — required
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth Web client — required for sign-in / Calendar / Drive
# Steps: README "Google OAuth" or Project store docs/google-oauth-setup.md
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional: public origin for Auth.js in production
# AUTH_URL=https://your-app.vercel.app

# Optional LLM for richer plans. If unset, a deterministic stub plan is used.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
