# Copy to .env.local. Kaung shares the real values privately; never commit them.

# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth client (the same one configured as Supabase's Google provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Encrypts the stored Google refresh token. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=

# Resend, verified club domain
RESEND_API_KEY=
EMAIL_FROM=

# Base URL for OAuth redirects, invite links and email links
APP_URL=http://localhost:3000
