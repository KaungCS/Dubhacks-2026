#!/usr/bin/env bash

set -u

usage() {
  cat <<'EOF'
Usage: scripts/start-issue ISSUE --base BRANCH [--dry-run]

Create a GitHub-linked issue branch in an isolated worktree.
EOF
}

die() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"
}

slugify() {
  printf '%s\n' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//' \
    | cut -c1-48 \
    | sed -E 's/-+$//'
}

main() {
  issue_ref=
  base_branch=
  dry_run=false

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --base)
        [ "$#" -ge 2 ] || die "--base requires a branch"
        base_branch=$2
        shift 2
        ;;
      --dry-run)
        dry_run=true
        shift
        ;;
      -*)
        die "unknown argument: $1"
        ;;
      *)
        [ -z "$issue_ref" ] || die "unexpected argument: $1"
        issue_ref=$1
        shift
        ;;
    esac
  done

  if [ -z "$issue_ref" ]; then
    usage >&2
    exit 1
  fi
  [ -n "$base_branch" ] || die "--base is required"

  require_command git
  require_command gh
  [ "$(git rev-parse --is-inside-work-tree 2>/dev/null)" = "true" ] || die "not inside a Git worktree"
  gh auth status >/dev/null 2>&1 || die "GitHub CLI is not authenticated; run: gh auth login"

  login=$(gh api user --jq .login 2>/dev/null) || die "could not determine the authenticated GitHub login"
  [ -n "$login" ] || die "could not determine the authenticated GitHub login"

  issue_data=$(gh issue view "$issue_ref" \
    --json number,title,state,assignees \
    --jq '[.number, .title, .state, ([.assignees[].login] | join(",")), "__END__"] | .[]' \
    2>/dev/null) || die "could not read issue details: $issue_ref"

  issue_number=$(printf '%s\n' "$issue_data" | sed -n '1p')
  issue_title=$(printf '%s\n' "$issue_data" | sed -n '2p')
  issue_state=$(printf '%s\n' "$issue_data" | sed -n '3p')
  issue_assignees=$(printf '%s\n' "$issue_data" | sed -n '4p')
  issue_sentinel=$(printf '%s\n' "$issue_data" | sed -n '5p')

  case "$issue_number" in
    ''|*[!0-9]*) die "could not read issue details: $issue_ref" ;;
  esac
  [ -n "$issue_title" ] || die "could not read issue details: $issue_ref"
  [ "$issue_sentinel" = "__END__" ] || die "could not read issue details: $issue_ref"
  [ "$issue_state" = "OPEN" ] || die "issue #$issue_number is not open"

  if [ -n "$issue_assignees" ] && [ "$issue_assignees" != "$login" ]; then
    die "issue #$issue_number is already assigned to: $issue_assignees"
  fi

  slug=$(slugify "$issue_title")
  [ -n "$slug" ] || slug=issue
  branch_name="$issue_number-$slug"
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || die "could not resolve the repository root"
  worktree_root="$repo_root/.worktrees"
  worktree_path="$worktree_root/$branch_name"

  git check-ignore -q "$worktree_root" 2>/dev/null \
    || die ".worktrees must be ignored before creating an issue worktree"
  [ ! -e "$worktree_path" ] || die "worktree path already exists: $worktree_path"

  if [ "$dry_run" = "true" ]; then
    if [ -z "$issue_assignees" ]; then
      printf 'DRY_RUN: gh issue edit %s --add-assignee @me\n' "$issue_number"
    fi
    printf 'DRY_RUN: gh issue develop %s --base %s --name %s --checkout --worktree %s\n' \
      "$issue_number" "$base_branch" "$branch_name" "$worktree_path"
  else
    if [ -z "$issue_assignees" ]; then
      gh issue edit "$issue_number" --add-assignee @me >/dev/null \
        || die "could not assign issue #$issue_number"
    fi
    mkdir -p "$worktree_root" || die "could not create worktree directory: $worktree_root"
    gh issue develop "$issue_number" \
      --base "$base_branch" \
      --name "$branch_name" \
      --checkout \
      --worktree "$worktree_path" \
      || die "could not create a linked branch for issue #$issue_number"
  fi

  printf 'ISSUE_NUMBER=%s\n' "$issue_number"
  printf 'BRANCH_NAME=%s\n' "$branch_name"
  printf 'WORKTREE_PATH=%s\n' "$worktree_path"
}

main "$@"
